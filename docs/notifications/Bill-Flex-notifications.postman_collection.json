{
  "info": {
    "name": "Bill-Flex · Notifications",
    "description": "Scénarios REST dans l’environnement local de notifications. Démarrer le client simulé du guide avant la création.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "clientId",
      "value": "42"
    },
    {
      "key": "manualInvoiceId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Créer une relance de test",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"manualInvoiceId\", Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"notificationId\", String(pm.response.json().id));",
              "pm.test(\"Type de notification\", () => pm.expect(pm.response.json().type).to.eql(\"RELANCE\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications",
        "body": {
          "mode": "raw",
          "raw": "{\"clientId\": {{clientId}}, \"invoiceId\": {{manualInvoiceId}}, \"type\": \"RELANCE\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Lister les notifications",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notifications"
      }
    },
    {
      "name": "Consulter par client",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notifications?clientId={{clientId}}"
      }
    },
    {
      "name": "Consulter par facture",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Une relance pour cette facture\", () => pm.expect(pm.response.json()).to.have.lengthOf(1));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notifications?invoiceId={{manualInvoiceId}}"
      }
    },
    {
      "name": "Consulter la notification créée",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notifications/{{notificationId}}"
      }
    },
    {
      "name": "Refuser une création dupliquée",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Conflit identifié\", () => pm.expect(pm.response.json().code).to.eql(\"NOTIFICATION_EXISTANTE\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications",
        "body": {
          "mode": "raw",
          "raw": "{\"clientId\": {{clientId}}, \"invoiceId\": {{manualInvoiceId}}, \"type\": \"RELANCE\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Refuser un identifiant invalide",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notifications?clientId=-1"
      }
    },
    {
      "name": "Signaler une notification introuvable",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notifications/9223372036854775807"
      }
    }
  ]
}
